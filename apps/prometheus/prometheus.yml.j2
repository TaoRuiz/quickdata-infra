global:
  scrape_interval: 5s
  scrape_timeout: 5s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter_workers'
    static_configs:
      - targets:
{% for host in groups['role_worker'] %}
          - '{{ hostvars[host]["private_ip_address"] }}:9100'
{% endfor %}